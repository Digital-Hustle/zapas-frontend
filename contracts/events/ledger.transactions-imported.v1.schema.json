{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zapas.app/events/ledger.transactions-imported.v1.schema.json",
  "title": "ledger.transactions-imported.v1",
  "description": "ledger.transactions-imported от ledger",
  "x-producer": "ledger",
  "x-consumers": [
    "forecast",
    "planning"
  ],
  "x-stream": "zapas.ledger.transactions-imported.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "companyId",
    "importId",
    "fromDate",
    "toDate",
    "rowsImported",
    "appendOnly"
  ],
  "properties": {
    "companyId": {
      "type": "string",
      "format": "uuid"
    },
    "importId": {
      "type": "string",
      "format": "uuid"
    },
    "fromDate": {
      "type": "string",
      "format": "date"
    },
    "toDate": {
      "type": "string",
      "format": "date"
    },
    "rowsImported": {
      "type": "integer"
    },
    "appendOnly": {
      "type": "boolean",
      "description": "true — только новые даты после прошлого импорта (инкрементальный пересчёт)"
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zapas.app/events/planning.events-changed.v1.schema.json",
  "title": "planning.events-changed.v1",
  "description": "planning.events-changed от planning",
  "x-producer": "planning",
  "x-consumers": [
    "forecast"
  ],
  "x-stream": "zapas.planning.events-changed.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "companyId",
    "sources",
    "fromDate"
  ],
  "properties": {
    "companyId": {
      "type": "string",
      "format": "uuid"
    },
    "sources": {
      "type": "array",
      "items": {
        "enum": [
          "INVOICE",
          "CONTRACT",
          "TAX",
          "MANUAL",
          "BANK",
          "INTEGRATION",
          "RECURRING"
        ]
      }
    },
    "fromDate": {
      "type": "string",
      "format": "date"
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zapas.app/events/auth.mail-command.v1.schema.json",
  "title": "auth.mail-command.v1",
  "description": "Письмо с OTP: в стриме только ссылка на шифрованный short-lived payload; notify читает внутренним scoped API и удаляет после отправки. Не копировать код в DLQ/logs.",
  "x-producer": "auth",
  "x-consumers": [
    "notify"
  ],
  "x-stream": "zapas.auth.mail-command.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "deliveryId",
    "expiresAt",
    "client"
  ],
  "properties": {
    "deliveryId": {
      "type": "string",
      "format": "uuid"
    },
    "expiresAt": {
      "type": "string",
      "format": "date-time"
    },
    "client": {
      "enum": [
        "WEB",
        "ADMIN",
        "ANDROID"
      ]
    },
    "locale": {
      "type": "string"
    }
  }
}

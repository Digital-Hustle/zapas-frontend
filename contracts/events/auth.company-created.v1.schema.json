{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zapas.app/events/auth.company-created.v1.schema.json",
  "title": "auth.company-created.v1",
  "description": "auth.company-created от auth",
  "x-producer": "auth",
  "x-consumers": [
    "planning",
    "forecast"
  ],
  "x-stream": "zapas.auth.company-created.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "companyId",
    "taxRegime",
    "hasEmployees",
    "minBalance"
  ],
  "properties": {
    "companyId": {
      "type": "string",
      "format": "uuid"
    },
    "taxRegime": {
      "enum": [
        "USN_INCOME",
        "USN_INCOME_MINUS_EXPENSES",
        "OSNO",
        "AUSN",
        "PSN"
      ]
    },
    "vatPayer": {
      "type": "boolean"
    },
    "hasEmployees": {
      "type": "boolean"
    },
    "payrollDays": {
      "type": "array",
      "items": {
        "type": "integer"
      }
    },
    "minBalance": {
      "type": "string"
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zapas.app/events/auth.member-invited.v1.schema.json",
  "title": "auth.member-invited.v1",
  "description": "auth.member-invited от auth",
  "x-producer": "auth",
  "x-consumers": [
    "notify"
  ],
  "x-stream": "zapas.auth.member-invited.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "companyId",
    "email",
    "role",
    "companyName",
    "inviterName"
  ],
  "properties": {
    "companyId": {
      "type": "string",
      "format": "uuid"
    },
    "email": {
      "type": "string",
      "format": "email"
    },
    "role": {
      "enum": [
        "OWNER",
        "ACCOUNTANT",
        "VIEWER"
      ]
    },
    "companyName": {
      "type": "string"
    },
    "inviterName": {
      "type": "string"
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zapas.app/events/forecast.forecast-updated.v1.schema.json",
  "title": "forecast.forecast-updated.v1",
  "description": "forecast.forecast-updated от forecast",
  "x-producer": "forecast",
  "x-consumers": [
    "notify"
  ],
  "x-stream": "zapas.forecast.forecast-updated.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "companyId",
    "runId",
    "level"
  ],
  "properties": {
    "companyId": {
      "type": "string",
      "format": "uuid"
    },
    "runId": {
      "type": "string",
      "format": "uuid"
    },
    "level": {
      "enum": [
        "NONE",
        "LOW",
        "MEDIUM",
        "HIGH"
      ]
    },
    "safeUntil": {
      "type": [
        "string",
        "null"
      ],
      "format": "date"
    }
  }
}

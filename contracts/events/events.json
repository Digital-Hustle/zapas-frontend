{
  "$comment": "Источник для tools/contracts/gen-events.mjs: генерирует <type>.v<N>.schema.json и README. Правьте здесь.",
  "stream": "zapas.{type}.v{version}",
  "events": [
    {
      "type": "auth.mail-command", "version": 1, "producer": "auth", "consumers": ["notify"],
      "description": "Письмо с OTP: в стриме только ссылка на шифрованный short-lived payload; notify читает внутренним scoped API и удаляет после отправки. Не копировать код в DLQ/logs.",
      "required": ["deliveryId", "expiresAt", "client"],
      "properties": {
        "deliveryId": { "type": "string", "format": "uuid" },
        "expiresAt": { "type": "string", "format": "date-time" },
        "client": { "enum": ["WEB", "ADMIN", "ANDROID"] },
        "locale": { "type": "string" }
      }
    },
    {
      "type": "auth.company-created", "version": 1, "producer": "auth", "consumers": ["planning", "forecast"],
      "required": ["companyId", "taxRegime", "hasEmployees", "minBalance"],
      "properties": {
        "companyId": { "type": "string", "format": "uuid" },
        "taxRegime": { "enum": ["USN_INCOME", "USN_INCOME_MINUS_EXPENSES", "OSNO", "AUSN", "PSN"] },
        "vatPayer": { "type": "boolean" },
        "hasEmployees": { "type": "boolean" },
        "payrollDays": { "type": "array", "items": { "type": "integer" } },
        "minBalance": { "type": "string" }
      }
    },
    {
      "type": "auth.company-updated", "version": 1, "producer": "auth", "consumers": ["planning", "forecast"],
      "required": ["companyId", "changed", "snapshot"],
      "properties": {
        "companyId": { "type": "string", "format": "uuid" },
        "changed": { "type": "array", "items": { "enum": ["taxRegime", "vatPayer", "hasEmployees", "payrollDays", "minBalance", "timezone"] } },
        "minBalance": { "type": "string" },
        "snapshot": {
          "type": "object",
          "required": ["taxRegime", "hasEmployees", "minBalance", "timezone", "version"],
          "properties": {
            "taxRegime": { "enum": ["USN_INCOME", "USN_INCOME_MINUS_EXPENSES", "OSNO", "AUSN", "PSN"] },
            "hasEmployees": { "type": "boolean" },
            "vatPayer": { "type": "boolean" },
            "payrollDays": { "type": "array", "items": { "type": "integer", "minimum": 1, "maximum": 31 } },
            "minBalance": { "type": "string" },
            "timezone": { "type": "string" },
            "version": { "type": "integer" }
          }
        }
      }
    },
    {
      "type": "auth.company-deleted", "version": 1, "producer": "auth", "consumers": ["ledger", "planning", "forecast", "notify"],
      "required": ["companyId"],
      "properties": { "companyId": { "type": "string", "format": "uuid" } }
    },
    {
      "type": "auth.member-invited", "version": 1, "producer": "auth", "consumers": ["notify"],
      "required": ["companyId", "email", "role", "companyName", "inviterName"],
      "properties": {
        "companyId": { "type": "string", "format": "uuid" },
        "email": { "type": "string", "format": "email" },
        "role": { "enum": ["OWNER", "ACCOUNTANT", "VIEWER"] },
        "companyName": { "type": "string" },
        "inviterName": { "type": "string" }
      }
    },
    {
      "type": "ledger.transactions-imported", "version": 1, "producer": "ledger", "consumers": ["forecast", "planning"],
      "required": ["companyId", "importId", "fromDate", "toDate", "rowsImported", "appendOnly"],
      "properties": {
        "companyId": { "type": "string", "format": "uuid" },
        "importId": { "type": "string", "format": "uuid" },
        "fromDate": { "type": "string", "format": "date" },
        "toDate": { "type": "string", "format": "date" },
        "rowsImported": { "type": "integer" },
        "appendOnly": { "type": "boolean", "description": "true — только новые даты после прошлого импорта (инкрементальный пересчёт)" }
      }
    },
    {
      "type": "ledger.categories-changed", "version": 1, "producer": "ledger", "consumers": ["forecast", "planning"],
      "required": ["companyId", "affectedCount"],
      "properties": {
        "companyId": { "type": "string", "format": "uuid" },
        "affectedCount": { "type": "integer" },
        "fromDate": { "type": "string", "format": "date" }
      }
    },
    {
      "type": "ledger.recurring-changed", "version": 1, "producer": "ledger", "consumers": ["forecast", "planning"],
      "required": ["companyId", "patternIds"],
      "properties": {
        "companyId": { "type": "string", "format": "uuid" },
        "patternIds": { "type": "array", "items": { "type": "string", "format": "uuid" } }
      }
    },
    {
      "type": "planning.events-changed", "version": 1, "producer": "planning", "consumers": ["forecast"],
      "required": ["companyId", "sources", "fromDate"],
      "properties": {
        "companyId": { "type": "string", "format": "uuid" },
        "sources": { "type": "array", "items": { "enum": ["INVOICE", "CONTRACT", "TAX", "MANUAL", "BANK", "INTEGRATION", "RECURRING"] } },
        "fromDate": { "type": "string", "format": "date" }
      }
    },
    {
      "type": "planning.expected-payment-overdue", "version": 1, "producer": "planning", "consumers": ["forecast", "notify"],
      "required": ["companyId", "eventId", "title", "amount", "plannedDate", "overdueDays"],
      "properties": {
        "companyId": { "type": "string", "format": "uuid" },
        "eventId": { "type": "string", "format": "uuid" },
        "title": { "type": "string" },
        "amount": { "type": "string" },
        "plannedDate": { "type": "string", "format": "date" },
        "overdueDays": { "type": "integer" }
      }
    },
    {
      "type": "forecast.forecast-updated", "version": 1, "producer": "forecast", "consumers": ["notify"],
      "required": ["companyId", "runId", "level"],
      "properties": {
        "companyId": { "type": "string", "format": "uuid" },
        "runId": { "type": "string", "format": "uuid" },
        "level": { "enum": ["NONE", "LOW", "MEDIUM", "HIGH"] },
        "safeUntil": { "type": ["string", "null"], "format": "date" }
      }
    },
    {
      "type": "forecast.alert-raised", "version": 1, "producer": "forecast", "consumers": ["notify"],
      "required": ["companyId", "alertId", "kind", "severity", "title", "actionUrl"],
      "properties": {
        "companyId": { "type": "string", "format": "uuid" },
        "alertId": { "type": "string", "format": "uuid" },
        "kind": { "enum": ["NEW_GAP", "GAP_PROBABILITY_UP", "GAP_RESOLVED", "PAYMENT_OVERDUE", "BELOW_THRESHOLD", "LOW_DATA_QUALITY", "COUNTERPARTY_STATUS", "TAX_DUE_SOON"] },
        "severity": { "enum": ["INFO", "WARNING", "CRITICAL"] },
        "title": { "type": "string" },
        "body": { "type": "string" },
        "riskId": { "type": ["string", "null"], "format": "uuid" },
        "actionUrl": { "type": "string" }
      }
    }
  ]
}

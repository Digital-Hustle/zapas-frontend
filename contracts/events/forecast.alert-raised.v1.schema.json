{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zapas.app/events/forecast.alert-raised.v1.schema.json",
  "title": "forecast.alert-raised.v1",
  "description": "forecast.alert-raised от forecast",
  "x-producer": "forecast",
  "x-consumers": [
    "notify"
  ],
  "x-stream": "zapas.forecast.alert-raised.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "companyId",
    "alertId",
    "kind",
    "severity",
    "title",
    "actionUrl"
  ],
  "properties": {
    "companyId": {
      "type": "string",
      "format": "uuid"
    },
    "alertId": {
      "type": "string",
      "format": "uuid"
    },
    "kind": {
      "enum": [
        "NEW_GAP",
        "GAP_PROBABILITY_UP",
        "GAP_RESOLVED",
        "PAYMENT_OVERDUE",
        "BELOW_THRESHOLD",
        "LOW_DATA_QUALITY",
        "COUNTERPARTY_STATUS",
        "TAX_DUE_SOON"
      ]
    },
    "severity": {
      "enum": [
        "INFO",
        "WARNING",
        "CRITICAL"
      ]
    },
    "title": {
      "type": "string"
    },
    "body": {
      "type": "string"
    },
    "riskId": {
      "type": [
        "string",
        "null"
      ],
      "format": "uuid"
    },
    "actionUrl": {
      "type": "string"
    }
  }
}

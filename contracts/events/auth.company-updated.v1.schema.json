{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zapas.app/events/auth.company-updated.v1.schema.json",
  "title": "auth.company-updated.v1",
  "description": "auth.company-updated от auth",
  "x-producer": "auth",
  "x-consumers": [
    "planning",
    "forecast"
  ],
  "x-stream": "zapas.auth.company-updated.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "companyId",
    "changed",
    "snapshot"
  ],
  "properties": {
    "companyId": {
      "type": "string",
      "format": "uuid"
    },
    "changed": {
      "type": "array",
      "items": {
        "enum": [
          "taxRegime",
          "vatPayer",
          "hasEmployees",
          "payrollDays",
          "minBalance",
          "timezone"
        ]
      }
    },
    "minBalance": {
      "type": "string"
    },
    "snapshot": {
      "type": "object",
      "required": [
        "taxRegime",
        "hasEmployees",
        "minBalance",
        "timezone",
        "version"
      ],
      "properties": {
        "taxRegime": {
          "enum": [
            "USN_INCOME",
            "USN_INCOME_MINUS_EXPENSES",
            "OSNO",
            "AUSN",
            "PSN"
          ]
        },
        "hasEmployees": {
          "type": "boolean"
        },
        "vatPayer": {
          "type": "boolean"
        },
        "payrollDays": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 1,
            "maximum": 31
          }
        },
        "minBalance": {
          "type": "string"
        },
        "timezone": {
          "type": "string"
        },
        "version": {
          "type": "integer"
        }
      }
    }
  }
}

{
  "name": "zapas-frontend",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.7",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "setup": "node tools/setup.mjs",
    "dev": "pnpm --filter @zapas/web dev",
    "dev:mock": "pnpm --filter @zapas/web dev:mock",
    "dev:ui": "pnpm --filter @zapas/web exec vite ../../packages/ui/examples --config vite.config.ts --port 5174",
    "build": "pnpm -r --filter ./apps/** --filter ./packages/** run --if-present build",
    "lint": "pnpm -r --filter ./apps/** --filter ./packages/** run --if-present lint",
    "typecheck": "pnpm -r --filter ./apps/** --filter ./packages/** run --if-present typecheck",
    "test": "pnpm -r --filter ./apps/** --filter ./packages/** run --if-present test",
    "check": "node tools/check.mjs all",
    "gen:tokens": "pnpm --filter @zapas/tokens gen",
    "gen:api": "pnpm --filter @zapas/api gen",
    "hub:sync": "node tools/hub/sync.mjs",
    "guard": "node tools/guard.mjs"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "@redocly/cli": "2.71.0",
    "@stoplight/prism-cli": "5.16.0",
    "lefthook": "2.2.2",
    "prettier": "3.9.10",
    "prettier-plugin-tailwindcss": "0.8.1"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "lefthook",
      "esbuild"
    ]
  }
}
